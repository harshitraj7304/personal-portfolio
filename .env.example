# ─────────────────────────────────────────────────────────────────────────────
#  Portfolio — environment variables
#
#  Copy this file to `.env.local` and fill in real values:
#      cp .env.example .env.local
#
#  `.env.local` is git-ignored (see .gitignore). NEVER commit real secrets.
#
#  ⚠️  THE ONE RULE THAT MATTERS
#  Vite inlines every variable prefixed with `VITE_` into the JavaScript bundle
#  as plain text. Anyone can read it with View Source. A secret with a `VITE_`
#  prefix is a PUBLISHED secret.
#
#      VITE_*            → shipped to the browser. URLs and flags only.
#      everything else   → server-side only (Vercel Functions in api/).
#
#  api/_lib/env.js asserts this at boot and refuses to start if a secret is
#  found under a VITE_ name.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
#  SUPABASE — Postgres + Auth + Storage
#  Dashboard → Project Settings → API
# ═════════════════════════════════════════════════════════════════════════════

# Project REST URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# "anon" / publishable key. Safe by design (RLS applies), but we still keep it
# server-side because the browser never talks to Supabase directly.
# Used together with the signed-in user's JWT so every admin query is RLS-checked.
SUPABASE_ANON_KEY=

# "service_role" / secret key.
# ⚠️  BYPASSES ROW LEVEL SECURITY COMPLETELY. Treat it like a root password.
# Used only for: auth admin operations, rate-limit counters, audit writes,
# and signing storage URLs. Never sent to the browser. Never VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=


# ═════════════════════════════════════════════════════════════════════════════
#  APPLICATION SECRETS
# ═════════════════════════════════════════════════════════════════════════════

# Server-side HMAC key for OTP hashing, share-token hashing and CSRF tokens.
# Must be at least 32 characters of real randomness. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates all outstanding OTP codes and share links.
AUTH_SECRET=

# Canonical public origin — used in emails, share links and redirects.
# Local:      http://localhost:5173
# Production: use the active Vercel deployment URL (or your own configured domain)
PUBLIC_SITE_URL=http://localhost:5173

# Optional. Leave EMPTY for host-only cookies (recommended — most secure).
# Only set this if you need the session shared across subdomains,
# e.g. `.example.com`.
SESSION_COOKIE_DOMAIN=

# Access-token cookie lifetime in seconds. Default 3600 (1 hour).
SESSION_TTL_SECONDS=3600

# Refresh-token cookie lifetime in seconds. Default 2592000 (30 days).
REFRESH_TTL_SECONDS=2592000


# ═════════════════════════════════════════════════════════════════════════════
#  EMAIL — Resend (transactional: OTP codes, contact notifications)
#  https://resend.com → API Keys
# ═════════════════════════════════════════════════════════════════════════════

# If this is empty:
#   development → emails are logged to the server console (OTP codes visible
#                  in `vercel dev` output, so you can test without a provider)
#   production   → email-dependent endpoints return 503 instead of failing silently
RESEND_API_KEY=

# Must be an address on a domain you have VERIFIED in Resend (SPF + DKIM).
# Until the domain is verified, Resend only delivers to your own account email.
RESEND_FROM_EMAIL=

# Where contact-form notifications are delivered.
CONTACT_NOTIFY_EMAIL=harshitraj7304845705@gmail.com


# ═════════════════════════════════════════════════════════════════════════════
#  AI ASSISTANT — Anthropic (Phase 9; unused until then)
#  https://console.anthropic.com → API Keys
# ═════════════════════════════════════════════════════════════════════════════

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5


# ═════════════════════════════════════════════════════════════════════════════
#  FIRST-ADMIN BOOTSTRAP — local machine only
#
#  Used ONCE by `npm run bootstrap:admin` to create your super-admin account.
#  Do NOT add these to Vercel. Clear them from .env.local after bootstrapping.
# ═════════════════════════════════════════════════════════════════════════════

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Harshit Raj


# ═════════════════════════════════════════════════════════════════════════════
#  WHATSAPP BUSINESS CLOUD API — Phase B, not implemented yet
#  Phase A (the deep-link button) needs none of this.
# ═════════════════════════════════════════════════════════════════════════════

# Public contact number in E.164 format, e.g. +919876543210
# ⚠️  A wa.me deep link puts this number in the public page HTML. See
#     docs/ARCHITECTURE.md § J — this conflicts with keeping your phone number
#     off the public site, and is disabled until you decide.
WHATSAPP_PHONE_E164=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
#  CLIENT-SIDE (bundled into JavaScript — never put a secret here)
# ═════════════════════════════════════════════════════════════════════════════

# Optional API origin override. Leave empty to use same-origin `/api`, which is
# correct for both `vercel dev` and production. Set it only when running Vite
# and the API on different ports. This is a URL, not a secret.
VITE_API_BASE_URL=
